{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image classes",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "classes": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "prompts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "classes"
  ],
  "additionalProperties": false
}
