{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured-data facts",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "template": {
                "type": "string",
                "pattern": "\\{value\\}"
              }
            },
            "required": [
              "template"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "minProperties": 1
              }
            },
            "required": [
              "values"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "facts"
  ],
  "additionalProperties": false
}
