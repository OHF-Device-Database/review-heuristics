{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language identification",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mask_words": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "mask_words"
  ],
  "additionalProperties": false
}
